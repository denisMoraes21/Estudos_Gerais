\ProvidesPackage{ppgee_style}

\RequirePackage{color}
\RequirePackage{listings}
\RequirePackage{xcolor}

\usetheme{Montpellier}

\definecolor{darkgreen}{RGB}{0,64,0}

\setbeamercolor{structure}{fg=darkgreen}
\setbeamercolor{palette primary}{bg=darkgreen, fg=white}
\setbeamercolor{palette secondary}{bg=darkgreen!80, fg=white}
\setbeamercolor{palette tertiary}{bg=darkgreen!70, fg=white}
\setbeamercolor{frametitle}{bg=darkgreen!85, fg=white}
\setbeamercolor{block title}{bg=darkgreen!80, fg=white}
\setbeamercolor{block body}{bg=darkgreen!10, fg=black}
\setbeamertemplate{footline}
{
    \leavevmode%
    \hbox{%
        \begin{beamercolorbox}[wd=\paperwidth,ht=2.5ex,dp=1ex,right]{footline}%
            \insertframenumber/\inserttotalframenumber\hspace*{0.3cm}\vspace{0.2cm} % margem direita maior
        \end{beamercolorbox}%
    }%
}



\lstset{
    inputencoding=utf8,
    extendedchars=true,
    language=C,                   % Linguagem C
    basicstyle=\ttfamily\small,   % Fonte monoespaçada
    keywordstyle=\color{green!70!black}\bfseries,
    commentstyle=\color{gray}\itshape,
    stringstyle=\color{orange},
    numbers=left,                 % Numeração de linhas
    numberstyle=\tiny,
    stepnumber=1,
    numbersep=5pt,
    backgroundcolor=\color{black!5}, % Fundo claro
    frame=single,                 % Borda ao redor
    breaklines=true,              % Quebra linhas longas
    tabsize=2,
    showstringspaces=false
}

\usepackage[utf8]{inputenc}
\usepackage{array}       % Para customizar colunas
\usepackage{tabularx}    % Para tabelas com largura ajustável
\usepackage{booktabs}    % Para linhas horizontais bonitas