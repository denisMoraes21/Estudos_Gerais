\frametitle{Testes Ad Hoc - Vantagens/Desvantagens}
Vantagens:
    \begin{itemize}
        \item Muito rápido;
        \item Simples;
        \item Pode encontrar falhas óbvias inesperadas.
    \end{itemize}
    Desvantagens:
    \begin{itemize}
        \item Pouca rastreabilidade;
        \item Difícil reproduzir;
        \item Cobertura desconhecida.
    \end{itemize}

