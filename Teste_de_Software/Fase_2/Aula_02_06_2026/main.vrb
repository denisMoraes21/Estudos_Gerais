\frametitle{Testes funcionais - Integração}
\begin{lstlisting}[basicstyle=\ttfamily\scriptsize]
import unittest
import requests

class TestHTTPPublishAndResponse(unittest.TestCase):
    BASE_URL = "http://localhost:5000"
    def test_publish_and_get_response(self):
        resp = requests.post(
            f"{self.BASE_URL}/publish",
            json={"message": "ping"}
        )

        self.assertEqual(resp.status_code, 200)
        resp = requests.get(f"{self.BASE_URL}/response")
        self.assertEqual(resp.status_code, 200)
        data = resp.json()
        self.assertIn("message", data)
        self.assertEqual(data["message"], "pong")

if __name__ == "__main__":
    unittest.main()
\end{lstlisting}
